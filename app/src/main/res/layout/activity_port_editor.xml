<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090D"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0E131B"
        app:menu="@menu/menu_port_editor"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/port_editor_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="#EAF2F8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_port_block" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.09"
            android:text="@string/port_editor_subtitle"
            android:textAllCaps="true"
            android:textColor="#5C6B7C"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/badgeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_port_badge"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:paddingVertical="2dp"
            android:textColor="#2FD4A7"
            android:textSize="12sp"
            tools:text="12" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/portListScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp" />
        </ScrollView>

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/port_editor_empty"
            android:textColor="#5C6B7C"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- 新增/编辑：输入框 + 取消 + 添加（保存） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/inputNewPort"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_port_input"
            android:fontFamily="monospace"
            android:hint="@string/port_editor_hint_new"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="5"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="#DBE4EE"
            android:textColorHint="#42505E"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCancelEdit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="@string/port_editor_cancel_edit"
            android:textColor="#8FA0B2"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_port_btn_add"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:minWidth="76dp"
            android:paddingHorizontal="18dp"
            android:stateListAnimator="@null"
            android:text="@string/port_editor_add"
            android:textColor="#06130F"
            android:textSize="14sp"
            tools:ignore="ButtonStyle" />
    </LinearLayout>
</LinearLayout>
