<?xml version="1.0" encoding="utf-8"?>
<!-- 关于对话框：图标 + 名称 + 版本 + GitHub/作者超链接 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp">

    <ImageView
        android:id="@+id/aboutIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/aboutName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="#1A1C1E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aboutVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#71757D"
        android:textSize="14sp"
        tools:text="v1.2.5" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:background="#E3E6EB" />

    <!-- GitHub 仓库（点击打开网页） -->
    <LinearLayout
        android:id="@+id/rowGithub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="@string/about_github_label"
            android:textColor="#71757D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/about_github_url"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/about_github_label"
            android:src="@drawable/ic_open_app"
            app:tint="@color/primary" />
    </LinearLayout>

    <!-- 作者（点击打开 B 站主页） -->
    <LinearLayout
        android:id="@+id/rowAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="@string/about_author_label"
            android:textColor="#71757D"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/about_author_name"
            android:textColor="@color/primary"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/about_author_label"
            android:src="@drawable/ic_open_app"
            app:tint="@color/primary" />
    </LinearLayout>
</LinearLayout>
