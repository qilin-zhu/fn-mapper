<?xml version="1.0" encoding="utf-8"?>
<!-- fnos-scanner .field input 同款：深底描边，聚焦时绿色描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0B0E14" />
            <stroke android:width="1dp" android:color="#8C2FD4A7" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0E14" />
            <stroke android:width="1dp" android:color="#1C2531" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
