<?xml version="1.0" encoding="utf-8"?>
<!-- fnos-scanner .ico-app 同款块图标：绿色圆角框 + 中心发光点 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#242FD4A7" />
            <stroke android:width="1dp" android:color="#472FD4A7" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#2FD4A7" />
        </shape>
    </item>
</layer-list>
